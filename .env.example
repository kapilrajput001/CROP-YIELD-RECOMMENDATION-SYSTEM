# Environment configuration — copy this file to .env and fill in values

# Flask configuration
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key-in-production
PORT=5000

# OpenWeatherMap API (optional — provides live weather data)
# Get a free key at: https://openweathermap.org/api
# Leave empty to use manual weather input mode
OPENWEATHER_API_KEY=

# Database path (default: instance/predictions.db — SQLite)
# No changes needed for local use
# DATABASE_URL=sqlite:///instance/predictions.db
